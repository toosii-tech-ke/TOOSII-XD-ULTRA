# WhatsApp account that runs the bot (the number you scan/pair with)
OWNER_NUMBER=2547XXXXXXXX

# Toosii Tech distribution API — where the launcher pulls updates from.
# Same token the bot already uses for its API features.
TOOSII_TECH_API_TOKEN=
DIST_API_BASE=https://toosiitechdevelopertools.zone.id

# Set to true to boot the current runtime without checking for updates
# LAUNCHER_SKIP_UPDATE=true
