# ── Toosii-XD-Ultra configuration ─────────────────────────────
# The account that RUNS the bot (the number you pair/scan with).
OWNER_NUMBER=2547XXXXXXXX

# Session string from the session generator — pair once in the browser,
# paste the string here. Leave empty to pair via console pairing code.
SESSION_ID=

# Bot display name (rebrandable at runtime with .botname)
BOT_NAME=TOOSII-XD-ULTRA

# Command prefix
PREFIX=.

# ── Launcher ──────────────────────────────────────────────────
# No API token needed — updates and bundles are served publicly.
# Optional overrides:
# DIST_API_BASE=https://toosiitechdevelopertools.zone.id
# LAUNCHER_SKIP_UPDATE=true
